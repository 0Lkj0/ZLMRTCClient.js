{
  "name": "zlmrtc-client",
  "title": "ZLM RTC player and pusher JavaScript SDK",
  "description": "ZLM RTC player and pusher JavaScript SDK",
  "version": "0.1.0",
  "main": "src/export.js",
  "keywords": [
    "webrtc",
    "ZLMediakit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "webrtc-adapter": "^7.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.1.2",
    "@babel/preset-env": "^7.24.7",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^18.0.0",
    "@rollup/plugin-eslint": "^8.0.1",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^11.2.1",
    "acorn": "^6.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "rollup": "^2.43.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-watch": "^4.3.1"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch --environment NODE_ENV:development",
    "pro": "rollup -c --environment NODE_ENV:production",
    "lint": "eslint  -c .eslintrc.json ./src/",
    "prepare": "husky && echo npx --no -- commitlint --edit > .husky/commit-msg && echo npx lint-staged > .husky/pre-commit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "**/*.{js,vue,html,css,scss,ts}": "prettier --write"
  },
  "prettier": {
    "printWidth": 120,
    "singleAttributePerLine": true,
    "htmlWhitespaceSensitivity": "ignore"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "build",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "test",
          "style",
          "review"
        ]
      ],
      "subject-empty": [
        0
      ]
    },
    "parserPreset": {
      "parserOpts": {
        "headerPattern": "^\\[(\\w*)](?:\\(([\\w$.\\-*/ ]*)\\))?: (.*)$"
      }
    }
  }
}
